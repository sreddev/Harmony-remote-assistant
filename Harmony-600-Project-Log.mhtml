 dark; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}

body { background: var(--bg); color: var(--ink); font: 15px/1.6 var(--f-bod=
y); padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right:=
 max(16px, env(safe-area-inset-right, 0px)); padding-block: 32px 64px; }

.wrap { max-width: 1180px; margin: 0px auto; display: grid; grid-template-c=
olumns: 200px minmax(0px, 1fr); gap: 48px; }

nav.toc { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 24px)=
; align-self: start; display: grid; gap: 2px; font-size: 13px; }

nav.toc .lbl { font: 600 11px/1 var(--f-body); letter-spacing: 0.08em; text=
-transform: uppercase; color: var(--muted); margin-bottom: 8px; }

nav.toc a { color: var(--muted); text-decoration: none; padding: 4px 8px; b=
order-left: 2px solid var(--line); }

nav.toc a:hover, nav.toc a:focus-visible { color: var(--accent); border-lef=
t-color: var(--accent); outline: none; }

main { min-width: 0px; display: grid; gap: 52px; }

header.hero { display: grid; gap: 14px; }

.eyebrow { font: 500 12px/1 var(--f-mono); color: var(--accent); letter-spa=
cing: 0.04em; }

h1 { font: 600 clamp(30px, 4.4vw, 44px)/1.1 var(--f-display); margin: 0px; =
text-wrap: balance; letter-spacing: -0.01em; }

h2 { font: 600 24px/1.2 var(--f-display); margin: 0px 0px 6px; text-wrap: b=
alance; }

h3 { font: 600 16px/1.3 var(--f-body); margin: 8px 0px 4px; }

p { margin: 0px 0px 12px; max-width: 68ch; }

.lede { font-size: 17px; color: var(--muted); max-width: 64ch; }

section { display: grid; gap: 14px; scroll-margin-top: 24px; }

section > .sub { color: var(--muted); margin: 0px; }

code { font-family: var(--f-mono); font-size: 0.9em; background: var(--code=
-bg); padding: 1px 5px; border-radius: 4px; overflow-wrap: anywhere; }

a { color: var(--accent); }

.status { display: grid; grid-template-columns: repeat(auto-fit, minmax(210=
px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line)=
; border-radius: 8px; overflow: hidden; }

.status div { background: var(--surface); padding: 14px 16px; display: grid=
; gap: 6px; align-content: start; }

.status b { font: 600 15px/1.3 var(--f-body); }

.status span { font-size: 13.5px; color: var(--muted); }

.chip { display: inline-block; font: 600 10.5px/1 var(--f-body); letter-spa=
cing: 0.06em; text-transform: uppercase; padding: 4px 7px; border-radius: 9=
9px; white-space: nowrap; vertical-align: 2px; width: fit-content; }

.chip.ok { background: var(--ok-soft); color: var(--ok); }

.chip.warn { background: var(--warn-soft); color: var(--warn); }

.chip.risk { background: var(--ir-soft); color: var(--ir); }

.tbl { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px;=
 background: var(--surface); }

table { border-collapse: collapse; width: 100%; font-size: 14px; }

th, td { text-align: left; vertical-align: top; padding: 9px 12px; border-b=
ottom: 1px solid var(--line); }

th { font: 600 11px/1.3 var(--f-body); letter-spacing: 0.06em; text-transfo=
rm: uppercase; color: var(--muted); background: var(--bg); white-space: now=
rap; }

tr:last-child td { border-bottom: 0px; }

td.num, .num { font-variant-numeric: tabular-nums; font-family: var(--f-mon=
o); }

td .names { font: 12.5px/1.5 var(--f-mono); color: var(--muted); }

.diagram { background: var(--surface); border: 1px solid var(--line); borde=
r-radius: 8px; padding: 16px; overflow-x: auto; }

.diagram pre.mermaid { margin: 0px; background: none; display: flex; justif=
y-content: center; min-width: 640px; }

.caption { font-size: 13px; color: var(--muted); margin: 0px; }

ol.steps { list-style: none; margin: 0px; padding: 0px; display: grid; coun=
ter-reset: s 0; }

ol.steps li { counter-increment: s 1; display: grid; grid-template-columns:=
 40px 1fr; gap: 14px; padding-bottom: 16px; position: relative; }

ol.steps li::before { content: counter(s); width: 30px; height: 30px; borde=
r-radius: 50%; background: var(--accent); color: var(--surface); font: 600 =
13px/30px var(--f-mono); text-align: center; z-index: 1; }

ol.steps li::after { content: ""; position: absolute; left: 14px; top: 30px=
; bottom: 0px; width: 2px; background: var(--line); }

ol.steps li:last-child::after { display: none; }

ol.steps b { display: block; }

ol.steps span { color: var(--muted); font-size: 14px; display: block; max-w=
idth: 70ch; }

.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280p=
x, 1fr)); gap: 14px; }

.card { background: var(--surface); border: 1px solid var(--line); border-r=
adius: 10px; padding: 16px; display: grid; gap: 8px; align-content: start; =
min-width: 0px; }

.card.ask { border-color: var(--warn); }

.card h3 { margin: 0px; font: 600 17px/1.3 var(--f-display); }

.card p { margin: 0px; font-size: 14.5px; }

pre.cmd { margin: 0px; background: var(--code-bg); border-radius: 6px; padd=
ing: 10px 12px; font: 12.5px/1.5 var(--f-mono); overflow-x: auto; white-spa=
ce: pre; }

ul.clean { margin: 0px; padding-left: 18px; display: grid; gap: 4px; font-s=
ize: 14.5px; }

footer { color: var(--muted); font-size: 13px; border-top: 1px solid var(--=
line); padding-top: 16px; display: grid; gap: 6px; }

@media (max-width: 860px) {
  .wrap { grid-template-columns: minmax(0px, 1fr); gap: 24px; }
  nav.toc { position: static; display: flex; flex-wrap: wrap; gap: 6px; }
  nav.toc .lbl { width: 100%; margin: 0px; }
  nav.toc a { border: 1px solid var(--line); border-radius: 99px; padding: =
4px 10px; }
}
