@charset "utf-8";

:root { --bg: #F3F6F7; --surface: #FFFFFF; --ink: #14232B; --muted: #56676F=
; --line: #D3DCE0; --accent: #007A80; --accent-soft: #DDF0F0; --ir: #B8324A=
; --ir-soft: #F7E3E7; --code-bg: #E8EEF0; --ok: #2F7D4A; --ok-soft: #E1F1E6=
; --warn: #9A6200; --warn-soft: #F8EDD6; --f-display: "Space Grotesk", "Seg=
oe UI", system-ui, sans-serif; --f-body: "IBM Plex Sans", "Segoe UI", syste=
m-ui, sans-serif; --f-mono: "IBM Plex Mono", ui-monospace, Consolas, monosp=
ace; }

@media (prefers-color-scheme: dark) {
  :root:not([data-theme=3D"light"]) { --bg: #0D1519; --surface: #131F25; --=
ink: #E2EBEE; --muted: #93A4AC; --line: #26363E; --accent: #3CC6CC; --accen=
t-soft: #143238; --ir: #F2808F; --ir-soft: #3A1C23; --code-bg: #1A2A31; --o=
k: #6CCB8B; --ok-soft: #173025; --warn: #E9B45A; --warn-soft: #33270F; colo=
r-scheme: dark; }
}

:root[data-theme=3D"dark"] { --bg: #0D1519; --surface: #131F25; --ink: #E2E=
BEE; --muted: #93A4AC; --line: #26363E; --accent: #3CC6CC; --accent-soft: #=
143238; --ir: #F2808F; --ir-soft: #3A1C23; --code-bg: #1A2A31; --ok: #6CCB8=
B; --ok-soft: #173025; --warn: #E9B45A; --warn-soft: #33270F; color-scheme:=
 dark; }

* { box-sizing: border-box; }

body { background: var(--bg); color: var(--ink); font: 15px/1.6 var(--f-bod=
y); padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right:=
 max(16px, env(safe-area-inset-right, 0px)); padding-block: 32px 64px; }

.wrap { max-width: 1180px; margin: 0px auto; display: grid; grid-template-c=
olumns: 200px minmax(0px, 1fr); gap: 48px; }

nav.toc { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 24px)=
; align-self: start; display: grid; gap: 2px; font-size: 13px; }

nav.toc .lbl { font: 600 11px/1 var(--f-body); letter-spacing: 0.08em; text=
