+"""The Harmony 600 backend: read a configuration back as a project. Nothing else.
+
+The 600's image is the Harmony One's `GSPM` with a different base, header constant and
+master index (layout.py). Reading runs the One's reader under the 600's layout. Building
+is refused here as well as by the profile's `read-only` status: nothing in this backend
+produces bytes for the remote.
+
+Format reference: docs/harmony_600/README.md
+"""
+
+from __future__ import annotations
+
+import hashlib
+
+from ..contracts import BuildResult, ImportResult
+from ..harmony_one import backend as one_backend
+from . import layout, pages
+
+SCREEN_GAPS = False
+
+
+class ReadOnly(RuntimeError):
+    """The 600 backend reads configurations; it does not build them."""
+
+
+def afterglow_built(payload: bytes) -> bool | None:
+    with layout.active():
+        return one_backend.afterglow_built(payload)
+
+
+def validate_payload(payload: bytes, _profile=None) -> dict:
+    return layout.validate(payload)
+
+
+def compare_payloads(recovery: bytes, candidate: bytes, _profile) -> dict:
+    def sections(payload):
+        return {f"section {index}": hashlib.sha256(payload[start:end]).hexdigest()
+                for index, (start, end) in layout.section_ranges(payload).items()}
+
+    before, after = sections(recovery), sections(candidate)
+    return {
+        "kind": "gspm-section-sha256",
+        "size before": len(recovery),
+        "size after": len(candidate),
+        "added": sorted(after.keys() - before.keys()),
+        "removed": sorted(before.keys() - after.keys()),
+        "changed": sorted(n for n in before.keys() & after.keys() if before[n] != after[n]),
+        "unchanged": sum(before[n] == after[n] for n in before.keys() & after.keys()),
+    }
+
+
+def import_project(source, profile, context) -> ImportResult:
+    """The One's reader, run against the 600's layout."""
+    payload = _payload(source, profile)
+    with layout.active():
+        result = one_backend.import_project(source, profile, context)
+        from ..harmony_one import command_index, key_index, labels
+        rows = pages.page_commands(payload, labels.Text(payload),
+                                   command_index.objects(payload), key_index.object_targets)
+    renamed = pages.rename_commands(result.project, rows)
+    preservation = dict(result.preservation)
+    preservation["validation"] = layout.validate(payload)
+    preservation["page_labels"] = rows
+    notes = ((f"{len(renamed)} commands named by the label beside the side key that sends "
+              "them",) if renamed else ())
+    return ImportResult(
+        project=result.project,
+        preservation=preservation,
+        warnings=result.warnings + notes + (
+            "Harmony 600 support is read-only: the One's reader run on the 600's layout. "
+            "Names, commands and activities are as far as that reader goes; nothing here "
+            "can be built or written to the remote.",),
+        rejected=result.rejected,
+    )
+
+
+def _payload(source, profile) -> bytes:
+    from ... import payloads
+    return payloads.get(profile.payload).build(source)
+
+
+def build_project(project, profile, context) -> BuildResult:
+    raise ReadOnly("Harmony 600 configurations are read-only in Afterglow: they can be "
+                   "imported and inspected, not built or written.")
+
+
+def capability(signal: dict, profile, *, library=None) -> dict:
+    return {"supported": False, "strategy": "unavailable",
+            "reason": "the Harmony 600 backend is read-only"}
+
+
+def translations() -> list[str]:
+    return []
