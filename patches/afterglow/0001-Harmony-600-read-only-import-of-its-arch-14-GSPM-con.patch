+"""The Harmony 600's keys: which scan code each key sends.
+
+The 600 binds keys the way the One does - a context or mode-list row for key `0x80 | scan`
+on a press - but it has 54 keys where the One has 40, numbered by its own keypad matrix,
+so none of the One's numbers carry over.
+
+Source: Danny Bloe's harmony-explorations (MIT), reference/remotes/harmony-600/keys.md,
+measured on a 600 and shared by the 650 and 700 (architecture 14): 36 keys named through
+Logitech's own button maps for a known setup, the four up/down keys by the devices' maps,
+Help by every Logitech compile, the activity and screen keys by behaviour. Cross-checked
+here: on the measured 600 the device-mode contexts bind exactly scans 1 to 54.
+https://github.com/dannybloe/harmony-explorations
+
+Not measured there, and left unnamed here rather than guessed: All Off, Enter (E) and the
+two arrows below the screen - which leaves scans 6, 11, 35 and 54 for those four.
+
+Format reference: docs/harmony_600/README.md
+"""
+from __future__ import annotations
+
+SCANS = {
+    # keypad, named through Logitech's button maps
+    "Menu": 10, "Exit": 12, "Red": 13, "VolumeUp": 14, "VolumeDown": 15, "VolumeMute": 16,
+    "Number4": 17, "Number7": 18, "NumberPlus": 19, "Number0": 20, "SkipBack": 21,
+    "Rewind": 22, "Record": 23, "Number1": 24, "Yellow": 28, "Blue": 29, "FastForward": 30,
+    "ChannelUp": 31, "ChannelDown": 32, "Guide": 33, "Info": 36, "Number6": 37,
+    "SkipForward": 38, "Number3": 39, "Stop": 40, "DirectionRight": 41, "PrevChannel": 43,
+    "Play": 44, "Number9": 45, "Pause": 46, "Number2": 47, "Number5": 48, "Green": 49,
+    "Select": 51, "DirectionLeft": 52, "Number8": 53,
+    # the up and down pairs, decided by the devices' own maps
+    "UpArrow": 26, "DownArrow": 27, "DirectionUp": 50, "DirectionDown": 42,
+    # keys the screen speaks for, by behaviour
+    "Help": 3, "WatchAMovie": 1, "WatchTV": 5, "ListenToMusic": 7, "MoreActivities": 4,
+    "ScreenUpperLeft": 8, "ScreenUpperRight": 2, "ScreenLowerLeft": 9,
+    "ScreenLowerRight": 34, "ScreenSelect": 25,
+}
+
+HELP = SCANS["Help"]
+ACTIVITIES = SCANS["MoreActivities"]
+OFF = None                     # All Off: one of scans 6, 11, 35, 54; not measured
+
+FLOW_KEYS = ("Help", "WatchAMovie", "WatchTV", "ListenToMusic", "MoreActivities",
+             "ScreenUpperLeft", "ScreenUpperRight", "ScreenLowerLeft", "ScreenLowerRight",
+             "ScreenSelect")
+COMMAND_KEYS = tuple(name for name in SCANS if name not in FLOW_KEYS)
+NAMES = {scan: name for name, scan in SCANS.items()}
diff --git a/src/afterglow/backends/harmony_600/layout.py b/src/afterglow/backends/harmony_600/layout.py
new file mode 100644
index 0000000..fee1062
--- /dev/null
+++ b/src/afterglow/backends/harmony_600/layout.py
@@ -0,0 +1,407 @@
+"""The Harmony 600's configuration image, as the Harmony One's reader addresses it.
+
+The 600 (arch 14, skin 71; Logitech's "Molson" family with the 650, 665 and 700) stores
+its configuration at `/cfg/usercfg` as a `GSPM` image, the Harmony One's format, with four
+measured differences:
+
+    field                One (arch 12)        600 (arch 14)
+    base address         0x040000             0x030000
+    header constant      0x1600               0x1400
+    master index         20 slots, 8 absent   18 slots, all present
+    LWJL marker          0x63                 0x5B (two fewer index slots)
+
+The checksum (two XOR lanes seeded 0x21/0x43), the end vector and the `PTYY` close are the
+One's exactly. The slots map onto the One's section numbers as
+
+    One 0..7   -> 600 slots 0..7
+    One 8      -> absent on both
+    One 9..18  -> 600 slots 8..17
+    One 19     -> absent: touch templates, and the 600 has no touchscreen
+
+measured by offering every 600 slot to every One section parser
+(tools/gspm600_matrix.py in Harmony-remote-assistant): the device index (5), fonts (7),
+object table (11 -> slot 10), drawing programs (12 -> slot 11) and engine records
+(14 -> slot 13) are each accepted by exactly one slot, consistent with this shift.
+
+Reading only. `active()` points the One's `gspm` module - and the touch-template reader -
+at this layout for the duration of a read, under a lock, and puts them back afterwards.
+
+Format reference: docs/harmony_600/README.md
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import struct
+import threading
+from functools import lru_cache
+from pathlib import Path
+
+from ..harmony_one import gspm as one_gspm
+from ..harmony_one import ui_index as one_ui_index
+from ..harmony_one import command_index as one_command_index
+from ..harmony_one import key_index as one_key_index
+from ..harmony_one import importing as one_importing
+from ..harmony_one import keys as one_keys
+from ..harmony_one import labels as one_labels
+from . import keys as keys_600
+
+BASE = 0x030000
+MAGIC = b"GSPM"
+HEADER_CONSTANT = 0x1400
+BUTTON_MAP_OFFSET = 0x5B
+BUTTON_MAP_MAGIC = b"LWJL"
+SLOT_COUNT = 18
+CHECKSUM_SEED = one_gspm.CHECKSUM_SEED
+# /cfg/usercfg on the 600 reports 3,997,696 bytes of room (libconcord's
+# get_config_bytes_total); stay well inside it.
+MAX_SAFE_SIZE = 0x3D0000
+
+ONE_SECTION_COUNT = 20
+# One section number -> 600 slot, None where the 600 has no such section.
+SLOT_FOR_ONE_SECTION: dict[int, int | None] = {
+    **{n: n for n in range(8)},
+    8: None,
+    **{n: n - 1 for n in range(9, 19)},
+    19: None,
+}
+NO_TOUCH_SECTION = 19
+
+_lock = threading.RLock()
+
+
+def checksum(data: bytes, end: int) -> tuple[int, int]:
+    return one_gspm.checksum(data, end)
+
+
+def slots(payload: bytes) -> list[int]:
+    """The master index as offsets relative to the payload."""
+    return [struct.unpack_from("<I", payload, 0x0C + 4 * i)[0] - BASE
+            for i in range(SLOT_COUNT)]
+
+
+def validate(payload: bytes) -> dict:
+    """The structural checks the One's validator makes, with the 600's measurements."""
+    if not isinstance(payload, bytes):
+        raise TypeError("GSPM payload must be bytes")
+    if len(payload) < BUTTON_MAP_OFFSET + len(BUTTON_MAP_MAGIC):
+        raise ValueError("GSPM payload is shorter than its fixed header")
+    if len(payload) >= MAX_SAFE_SIZE:
+        raise ValueError(f"GSPM payload is {len(payload):#x} bytes; limit {MAX_SAFE_SIZE:#x}")
+    if payload[:4] != MAGIC:
+        raise ValueError(f"GSPM magic is {payload[:4]!r}, expected {MAGIC!r}")
+    end_vector, constant = struct.unpack_from("<II", payload, 4)
+    if constant != HEADER_CONSTANT:
+        raise ValueError(
+            f"GSPM header constant is {constant:#x}, expected {HEADER_CONSTANT:#x} (arch 14)")
+    marker = end_vector - BASE
+    if marker < 2 or marker + 4 != len(payload) or payload[marker:marker + 4] != b"PTYY":
+        raise ValueError(f"GSPM end vector {end_vector:#08x} does not point at the final PTYY")
+    if payload[BUTTON_MAP_OFFSET:BUTTON_MAP_OFFSET + 4] != BUTTON_MAP_MAGIC:
+        raise ValueError(f"LWJL marker is absent at {BUTTON_MAP_OFFSET:#x}")
+    checksum_offset = marker - 2
+    actual = checksum(payload, checksum_offset)
+    stored = tuple(payload[checksum_offset:marker])
+    if actual != stored:
+        raise ValueError(f"GSPM checksum mismatch: computed {bytes(actual).hex()}, "
+                         f"stored {bytes(stored).hex()}")
+    offsets = slots(payload)
+    if any(not 0 <= o < checksum_offset for o in offsets):
+        raise ValueError("a master-index slot points outside the configuration")
+    if len(set(offsets)) != len(offsets):
+        raise ValueError("master-index slots are not unique")
+    return {
+        "ok": True,
+        "validator": "harmony-600/gspm-structural",
+        "size": len(payload),
+        "end_vector": end_vector,
+        "checksum": bytes(actual).hex(),
+        "sections": len(offsets),
+        "preserved_bytes": len(payload),
+    }
+
+
+def section_ranges(payload: bytes) -> dict[int, tuple[int, int]]:
+    """Section ranges keyed by the One's section numbers, as the One's readers ask."""
+    validate(payload)
+    offsets = slots(payload)
+    checksum_offset = struct.unpack_from("<I", payload, 4)[0] - BASE - 2
+    bounds = sorted(offsets) + [checksum_offset]
+    by_slot = {slot: (start, bounds[bounds.index(start) + 1])
+               for slot, start in enumerate(offsets)}
+    return {one: by_slot[slot] for one, slot in SLOT_FOR_ONE_SECTION.items()
+            if slot is not None}
+
+
+def _touch_templates(payload: bytes) -> dict[int, list[dict]]:
+    return {}
+
+
+def _u24(payload: bytes, offset: int) -> int:
+    return int.from_bytes(payload[offset:offset + 3], "little")
+
+
+def _rel(payload: bytes, offset: int, label: str) -> int:
+    relative = _u24(payload, offset) - BASE
+    if not 0 <= relative < len(payload):
+        raise ValueError(f"{label} points outside the GSPM image")
+    return relative
+
+
+def _screens(payload: bytes):
+    """(ordinal, trailer, header register, [slot offsets]) for every section-6 screen.
+
+    The trailer is the One's - `[byte][u24 header register][u16 slot count][u24 slot]...` -
+    and so is the screen index before it. The header register is the screen's key
+    register: every physical key it answers, the buttons beside the LCD among them.
+    """
+    start, end = section_ranges(payload)[6]
+    count = struct.unpack_from("<H", payload, start)[0]
+    if payload[start + 2] != 0 or start + 3 + 3 * count > end:
+        raise ValueError("section 6 has an invalid screen index")
+    for ordinal in range(count):
+        trailer = _rel(payload, start + 3 + 3 * ordinal, f"screen {ordinal}")
+        slot_count = struct.unpack_from("<H", payload, trailer + 4)[0]
+        header = _rel(payload, trailer + 1, f"screen {ordinal} header register")
+        offsets = [_rel(payload, trailer + 6 + 3 * i, f"screen {ordinal} slot {i}")
+                   for i in range(slot_count)]
+        yield ordinal, trailer, header, offsets
+
+
+def _register(payload: bytes, offset: int) -> list[dict]:
+    count = payload[offset]
+    if offset + 1 + 4 * count > len(payload):
+        raise ValueError(f"key register at {offset:#x} is truncated")
+    out = []
+    for entry in range(count):
+        at = offset + 1 + 4 * entry
+        operand, category = struct.unpack_from("<HB", payload, at + 1)
+        out.append({"key_code": payload[at], "operand": operand, "category": category,
+                    "offset": at})
+    return out
+
+
+def _screen_slots(payload: bytes) -> list[dict]:
+    """The One's `ui_index.screen_slots`, for the 600's slot record.
+
+    A One slot is `[template][u24 key register][u24 program]`, seven bytes; a 600 slot is
+    the same without the template byte, `[u24 key register][u24 program]`. The register
+    holds the keys that page answers - the four beside the screen among them.
+    """
+    screens = []
+    for ordinal, trailer, header, offsets in _screens(payload):
+        slots = []
+        for index, offset in enumerate(offsets):
+            register = _rel(payload, offset, f"screen {ordinal} slot {index} key register")
+            slots.append({
+                "index": index, "offset": offset, "template": None,
+                "key_register_offset": register,
+                "program_offset": _rel(payload, offset + 3,
+                                       f"screen {ordinal} slot {index} program"),
+                "entries": _register(payload, register),
+            })
+        try:
+            header_entries = one_ui_index.register_rows(payload, header)
+        except ValueError:
+            header_entries = []
+        screens.append({"ordinal": ordinal, "trailer_offset": trailer, "slots": slots,
+                        "header_offset": header, "header_entries": header_entries})
+    return screens
+
+
+def _key_index_inspect(payload: bytes, ownership: dict | None = None) -> dict:
+    """The One's `key_index.inspect` for the 600: every page's key register.
+
+    Same resolution as the One's - an entry of class 7F runs an object, followed directly
+    or through one jump to the command (7D), device (7C) or page (7E) it reaches.
+    """
+    from collections import Counter
+    ownership = one_command_index.inspect(payload) if ownership is None else ownership
+    indexed = {c["command_id"] for d in ownership["devices"] for c in d["commands"]}
+    objects = one_command_index.objects(payload)
+    counts, rejected, bindings = Counter(), Counter(), []
+    for screen in _screen_slots(payload):
+        counts["screens"] += 1
+        for slot in screen["slots"]:
+            counts["slots"] += 1
+            counts["key_registers"] += 1
+            counts["entries"] += len(slot["entries"])
+            for entry in slot["entries"]:
+                if entry["category"] != 0x7F:
+                    counts["other_class_bindings"] += 1
+                    continue
+                targets = one_key_index.object_targets(objects, entry["operand"])
+                if targets is None:
+                    rejected["invalid_object_index"] += 1
+                    continue
+                commands = {v for v, op in targets if op == 0x7D}
+                devices = {v for v, op in targets if op == 0x7C}
+                pages = {v for v, op in targets if op == 0x7E}
+                if not commands:
+                    counts["page_bindings" if pages else "non_command_bindings"] += 1
+                    continue
+                if len(commands) != 1 or len(devices) > 1:
+                    rejected["ambiguous_command_action"] += 1
+                    continue
+                command_id = next(iter(commands))
+                if command_id not in indexed:
+                    rejected["command_without_section5_record"] += 1
+                    continue
+                bindings.append({
+                    "screen": screen["ordinal"], "slot": slot["index"], "template": None,
+                    "key_code": entry["key_code"], "object_index": entry["operand"],
+                    "command_id": command_id, "device_ids": sorted(devices),
+                    "target_pages": sorted(pages),
+                    "key_register_offset": slot["key_register_offset"],
+                    "program_offset": slot["program_offset"],
+                })
+                counts["command_bindings"] += 1
+    for key in ("screens", "slots", "key_registers", "entries", "command_bindings",
+                "page_bindings", "other_class_bindings"):
+        counts[key] += 0
+    return {"counts": dict(counts), "rejected": dict(rejected), "bindings": bindings}
+
+
+_one_decode_waveform = one_command_index._decode_waveform
+
+
+def _decode_waveform(payload: bytes, offset: int, *, press: bool) -> dict:
+    """The One's waveform reader, allowing a press with no lead-in silence.
+
+    The One's presses all open with silence before the first mark. 18 of the measured
+    600's 175 commands open straight on the mark (a 4500 us leader, the same code family
+    as the rest); read the same way, with a lead-in of 0.
+    """
+    try:
+        return _one_decode_waveform(payload, offset, press=press)
+    except ValueError as exc:
+        if press and "no lead-in" in str(exc):
+            return _one_decode_waveform(payload, offset, press=False)
+        raise
+
+
+STARTING = "Starting "
+_one_activity = one_importing.Activities.activity
+
+
+def _start_screen_name(activities, ordinal: int) -> str | None:
+    """An activity's name from the screen its start shows first.
+
+    Every 600 activity's enter hook opens with `mode N`, and screen N draws "Starting
+    <name>" over "Please keep the remote pointed at your system", one such screen per
+    activity on the measured image. The One names activities from its menu instead,
+    which the 600 draws with icons rather than text.
+    """
+    from ..harmony_one import activity_index
+    image = activities.image
+    hooks = activities.hooks(activities.contexts[ordinal])
+    screen = next((step[1] for step in hooks.get(activity_index.ENTER, [])
+                   if step[0] == "mode"), None)
+    if screen is None:
+        return None
+    for ordinal_, _trailer, _header, offsets in _screens(image.payload):
+        if ordinal_ != screen:
+            continue
+        for offset in offsets:
+            program = _rel(image.payload, offset + 3, "start screen program")
+            items = one_labels.screen_text(image.payload, program, image.text)
+            first = items[0].get("text", "") if items else ""
+            if first.startswith(STARTING) and first[len(STARTING):].strip():
+                return first[len(STARTING):].strip()
+    return None
+
+
+def _activity(self, ordinal: int, label: str | None) -> dict:
+    if not label:
+        try:
+            label = _start_screen_name(self, ordinal)
+        except (ValueError, IndexError, KeyError):
+            label = None
+    return _one_activity(self, ordinal, label)
+
+
+SHAPES_FILE = Path(__file__).with_name("glyph-shapes.json")
+
+
+@lru_cache(maxsize=1)
+def glyph_shapes() -> dict[str, str]:
+    """The 600's LCD glyph shapes -> character (tools/make_600_glyph_shapes.py). Logitech
+    numbers each configuration's characters its own way; what a glyph looks like is the
+    same on every 600, so the shapes are what carries from one image to the next."""
+    if not SHAPES_FILE.is_file():
+        return {}
+    return dict(json.loads(SHAPES_FILE.read_text("utf-8"))["shapes"])
+
+
+def _with_600_shapes(original):
+    def shapes(directory=None):
+        return {**original(directory), **glyph_shapes()}
+    return shapes
+
+
+def _command_objects(payload: bytes) -> dict[int, list[dict]]:
+    """Command objects grouped by command ID, as the One's `command_objects` returns them.
+
+    The One's command object is two atoms, `(command, 7D) (device, 7C)`. The 600's has a
+    third in front, `(object, 7F)`: it calls another object first - the inter-device
+    delay gate its variables name (`InterDeviceDelay_<device>_...`) - then sends. On the
+    measured image exactly 175 objects have the shape `7F 7D 7C`, one per command the
+    section-5 index declares.
+    """
+    from collections import defaultdict
+    found: dict[int, list[dict]] = defaultdict(list)
+    for item in one_command_index.objects(payload):
+        atoms = item["atoms"]
+        if len(atoms) == 3 and atoms[0][1] == 0x7F:
+            atoms = atoms[1:]
+        if len(atoms) != 2 or atoms[0][1] != 0x7D or atoms[1][1] != 0x7C:
+            continue
+        found[atoms[0][0]].append({
+            "object_index": item["index"],
+            "object_offset": item["offset"],
+            "device_id": atoms[1][0],
+        })
+    return dict(found)
+
+
+@contextlib.contextmanager
+def active():
+    """Read with the One's modules as if they were written for the 600."""
+    patches = {
+        (one_gspm, "BASE"): BASE,
+        (one_gspm, "HEADER_CONSTANT"): HEADER_CONSTANT,
+        (one_gspm, "BUTTON_MAP_OFFSET"): BUTTON_MAP_OFFSET,
+        (one_gspm, "MAX_SAFE_SIZE"): MAX_SAFE_SIZE,
+        (one_gspm, "validate"): validate,
+        (one_gspm, "section_ranges"): section_ranges,
+        (one_ui_index, "touch_templates"): _touch_templates,
+        (one_command_index, "command_objects"): _command_objects,
+        (one_ui_index, "screen_slots"): _screen_slots,
+        (one_command_index, "_decode_waveform"): _decode_waveform,
+        (one_key_index, "inspect"): _key_index_inspect,
+    }
+    # The 600's 54 keys in place of the One's 40 (keys.py).
+    patches.update({
+        (one_keys, "SCANS"): keys_600.SCANS,
+        (one_keys, "_NAMES"): keys_600.NAMES,
+        (one_keys, "COMMAND_KEYS"): keys_600.COMMAND_KEYS,
+        (one_keys, "HELP"): keys_600.HELP,
+        (one_keys, "ACTIVITIES"): keys_600.ACTIVITIES,
+        (one_keys, "OFF"): keys_600.OFF,
+        (one_importing, "OFF_KEY"): None,
+        (one_importing.Activities, "activity"): _activity,
+    })
+    # Logitech's own builder drew these glyphs, so they join its shapes: that is what makes
+    # the reader treat codes as image-wide, as Logitech numbers them.
+    patches[(one_labels, "logitech_shapes")] = _with_600_shapes(one_labels.logitech_shapes)
+    patches[(one_labels, "known_shapes")] = _with_600_shapes(one_labels.known_shapes)
+    with _lock:
+        saved = {key: getattr(*key) for key in patches}
+        try:
+            for (module, name), value in patches.items():
+                setattr(module, name, value)
+            yield
+        finally:
+            for (module, name), value in saved.items():
+                setattr(module, name, value)
