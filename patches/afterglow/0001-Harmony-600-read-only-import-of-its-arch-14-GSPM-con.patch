@@ -0,0 +1,154 @@
+"""The labels a Harmony 600 page draws beside its four side keys, and what each key sends.
+
+A device or activity page on the 600 is a section-6 slot: a key register (the keys the
+page answers) and a drawing program. The program draws each side key's label as text,
+either inline - `05 x y <glyph codes> 00` - or by pointer - `04 x y <u24 address>` to a
+glyph string another page also uses. A label of two lines is two such texts in one
+corner. The corner a text sits in says which side key it names.
+
+The side keys' scan codes are harmony-explorations' (keys.py): 9 and 34 bottom left and
+right, 8 and 2 the top pair. Which of 8 and 2 is the top left is settled by
+`SIDE_KEYS` below, checked against the TV of the measured image, whose Samsung codes name
+themselves: the page labelled HDMI1, HDMI2, HDMI3, Source and 3D sends exactly those codes.
+
+Reading only. Format reference: docs/harmony_600/README.md; docs/harmony_one/ for the shared drawing VM.
+"""
+
+from __future__ import annotations
+
+from . import layout
+
+TEXT_INLINE, TEXT_POINTER = 0x05, 0x04
+MAX_GLYPH = 0x4A          # the highest glyph code a 600 image's fonts number
+MIDDLE_X, MIDDLE_Y = 64, 65
+TITLE_BELOW = 20          # a page's title and its page count ("1/5") sit at y 0 to 2
+CENTRE_FROM = 105         # the centre key's label ("Back", "Devices") sits at y 114
+SIDE_KEYS = {             # (top?, left?) -> scan code
+    (True, True): 8, (True, False): 2, (False, True): 9, (False, False): 34,
+}
+CENTRE_KEY = 25
+
+
+def _glyph_run(payload: bytes, at: int) -> bytes | None:
+    end = at
+    while end < len(payload) and 1 <= payload[end] <= MAX_GLYPH and end - at < 40:
+        end += 1
+    if end == at or end >= len(payload) or payload[end] != 0:
+        return None
+    return payload[at:end]
+
+
+def texts(payload: bytes, program: int, end: int) -> list[tuple[int, int, bytes]]:
+    """Every (x, y, glyphs) the program between ``program`` and ``end`` draws as text."""
+    out, at = [], program
+    while at < end - 3:
+        op, x, y = payload[at], payload[at + 1], payload[at + 2]
+        if op == TEXT_INLINE and x < 128 and y < 128:
+            run = _glyph_run(payload, at + 3)
+            if run:
+                out.append((x, y, run))
+                at += 4 + len(run)
+                continue
+        if op == TEXT_POINTER and x < 128 and y < 128:
+            target = int.from_bytes(payload[at + 3:at + 6], "little") - layout.BASE
+            if 0 <= target < len(payload):
+                run = _glyph_run(payload, target)
+                if run:
+                    out.append((x, y, run))
+                    at += 6
+                    continue
+        at += 1
+    return out
+
+
+def side_labels(payload: bytes, program: int, end: int, decode) -> dict[int, str]:
+    """scan code -> the label drawn beside that side key, lines joined by a space."""
+    corners: dict[int, list[tuple[int, str]]] = {}
+    for x, y, run in texts(payload, program, end):
+        if y < TITLE_BELOW:
+            continue
+        scan = (CENTRE_KEY if y >= CENTRE_FROM
+                else SIDE_KEYS[(y < MIDDLE_Y, x < MIDDLE_X)])
+        corners.setdefault(scan, []).append((y, decode(run)))
+    return {scan: " ".join(text for _, text in sorted(lines)).strip()
+            for scan, lines in corners.items()}
+
+
+def rename_commands(project: dict, rows: list[dict]) -> list[str]:
+    """Name each placeholder command ("Command 2E") by the label of the one side key that
+    sends it alone, and follow the rename everywhere the project refers to it.
+
+    A key that sends several commands (a sequence) names none of them. A command that
+    already has a name - a hard key's, a power command - keeps it. A label two commands
+    of one device share keeps the second its placeholder. Returns what was renamed.
+    """
+    devices = project["devices"]
+    renames: dict[str, dict[str, str]] = {}
+    for row in rows:
+        if len(row["command_ids"]) != 1 or not row["label"]:
+            continue
+        command_id = row["command_ids"][0]
+        index, ordinal = command_id >> 8, command_id & 0xFF
+        if not 0 <= index < len(devices):
+            continue
+        device = devices[index]
+        old = f"Command {ordinal:02X}"
+        signals = device.get("signals") or {}
+        taken = set(signals) | set(renames.get(device["id"], {}).values())
+        if old not in signals or old in renames.get(device["id"], {}) or row["label"] in taken:
+            continue
+        renames.setdefault(device["id"], {})[old] = row["label"]
+    for device in devices:
+        mapping = renames.get(device["id"])
+        if not mapping:
+            continue
+        signals = device["signals"]
+        device["signals"] = {mapping.get(name, name): signal for name, signal in signals.items()}
+        for row in device.get("commands") or []:      # [name, label, ...] per command
+            if isinstance(row, list) and row and row[0] in mapping:
+                row[0] = mapping[row[0]]
+        for signal in device["signals"].values():
+            if signal.get("name") in mapping:
+                signal["name"] = mapping[signal["name"]]
+
+    def walk(value):
+        if isinstance(value, list):
+            if (len(value) == 3 and value[0] == "command" and value[1] in renames
+                    and value[2] in renames[value[1]]):
+                value[2] = renames[value[1]][value[2]]
+            for item in value:
+                walk(item)
+        elif isinstance(value, dict):
+            for key in list(value):
+                walk(value[key])
+            for device_id, mapping in renames.items():
+                for field in ("power_cmd", "power_on_cmd", "power_off_cmd"):
+                    if value.get(field) in mapping and value.get("id") == device_id:
+                        value[field] = mapping[value[field]]
+
+    walk(project)
+    return [f"{device_id}: {old} -> {new}" for device_id, mapping in renames.items()
+            for old, new in mapping.items()]
+
+
+def page_commands(payload: bytes, text, objects, key_targets) -> list[dict]:
+    """Each side key on each page: its label and the command its press sends."""
+    out = []
+    for screen in layout._screen_slots(payload):
+        for slot in screen["slots"]:
+            labels = side_labels(payload, slot["program_offset"], slot["offset"],
+                                 lambda run: text.decode(run, None))
+            if not labels:
+                continue
+            for entry in slot["entries"]:
+                if entry["key_code"] & 0xC0 != 0x80 or entry["category"] != 0x7F:
+                    continue
+                scan = entry["key_code"] & 0x3F
+                if scan not in labels:
+                    continue
+                targets = key_targets(objects, entry["operand"]) or []
+                commands = sorted({v for v, op in targets if op == 0x7D})
+                out.append({"screen": screen["ordinal"], "slot": slot["index"],
+                            "scan": scan, "label": labels[scan],
+                            "command_ids": commands})
+    return out
